<Window
    x:Class="Music.TrackDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Music"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Detalhes — Music Recognizer"
    Width="920"
    Height="660"
    MinWidth="740"
    MinHeight="520"
    Background="#111111"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6366F1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Top: cover + info ══ -->
        <Border
            Grid.Row="0"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,0,0,1"
            Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cover art -->
                <Border
                    Grid.Column="0"
                    Width="210"
                    Height="210"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Background="#2C2C2E"
                    VerticalAlignment="Top">
                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Track info -->
                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        LineHeight="32" />
                    <TextBlock
                        x:Name="ArtistText"
                        FontSize="16"
                        Foreground="#9CA3AF"
                        Margin="0,6,0,0" />
                    <TextBlock
                        x:Name="MetaText"
                        FontSize="13"
                        Foreground="#6B7280"
                        Margin="0,5,0,0" />

                    <!-- Stats row -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border Background="#1F2937" CornerRadius="7" Padding="12,6">
                            <TextBlock x:Name="RecognitionText" FontSize="13" Foreground="#D1D5DB" />
                        </Border>
                        <Border Background="#1F2937" CornerRadius="7" Padding="12,6" Margin="8,0,0,0">
                            <TextBlock x:Name="LastSeenText" FontSize="13" Foreground="#D1D5DB" />
                        </Border>
                    </StackPanel>

                    <!-- Download status -->
                    <Border x:Name="DownloadBadge" CornerRadius="9" Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DownloadIcon" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DownloadLabel" FontSize="13" FontWeight="SemiBold" />
                                <ProgressBar
                                    x:Name="DownloadProgressBar"
                                    Width="220"
                                    Height="4"
                                    Minimum="0"
                                    Maximum="100"
                                    Margin="0,5,0,0"
                                    Background="#2C2C2E"
                                    Foreground="#F59E0B"
                                    BorderThickness="0"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button
                            x:Name="PlayBtn"
                            Content="▶  Reproduzir"
                            Click="PlayBtn_Click"
                            Style="{StaticResource PlayBtn}"
                            Margin="0,0,8,0" />
                        <Button
                            x:Name="OpenFolderBtn"
                            Content="📁  Abrir pasta"
                            Click="OpenFolderBtn_Click"
                            Style="{StaticResource ActionBtn}"
                            Margin="0,0,8,0" />
                        <Button
                            x:Name="ShazamBtn"
                            Content="🔍  Shazam"
                            Click="ShazamBtn_Click"
                            Style="{StaticResource ActionBtn}"
                            Margin="0,0,8,0" />
                        <Button
                            x:Name="SpotifyBtn"
                            Content="Spotify"
                            Click="SpotifyBtn_Click"
                            Style="{StaticResource ActionBtn}"
                            Margin="0,0,8,0" />
                        <Button
                            x:Name="YouTubeBtn"
                            Content="YouTube"
                            Click="YouTubeBtn_Click"
                            Style="{StaticResource ActionBtn}" />
                        <Button
                            x:Name="DeleteBtn"
                            Content="🗑"
                            Click="DeleteBtn_Click"
                            Margin="16,0,0,0"
                            Padding="12,9"
                            ToolTip="Excluir música (registro + arquivo)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                    <Setter Property="Foreground" Value="#EF4444" />
                                    <Setter Property="BorderBrush" Value="#3F1515" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3F1515" />
                                            <Setter Property="Foreground" Value="#FCA5A5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Recommendations ══ -->
        <Grid Grid.Row="1" Margin="28,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Section header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="4" Height="20" Background="#6366F1" CornerRadius="2" Margin="0,0,10,0" />
                <TextBlock Text="Músicas Parecidas" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="RecCount" FontSize="13" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Recommendation cards (horizontal scroll) -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                Padding="0,0,0,16">
                <ItemsControl x:Name="RecList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="155"
                                Margin="5"
                                CornerRadius="12"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseDown="RecCard_MouseDown"
                                Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1C1C1E" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2A2D" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="155" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Row="1" Margin="10,8,10,12">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding Artist}"
                                            FontSize="10"
                                            Foreground="#9CA3AF"
                                            Margin="0,3,0,0"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock
                x:Name="RecEmpty"
                Grid.Row="1"
                Text="Nenhuma recomendação disponível ainda. A música precisa ser reconhecida 3+ vezes."
                FontSize="13"
                Foreground="#6B7280"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>

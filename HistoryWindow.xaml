<Window
    x:Class="Music.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Music"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Suas Músicas — Music Recognizer"
    Width="1060"
    Height="760"
    MinWidth="800"
    MinHeight="560"
    Background="#111111"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
        </Style>

        <!-- Ghost/action button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filled primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7578F3" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Page nav button -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Recommendation card (ForYouItem) — enriched when track exists in history -->
        <DataTemplate x:Key="RecommendedCardTemplate">
            <Border
                Width="190"
                Margin="5"
                CornerRadius="14"
                ClipToBounds="True"
                Cursor="Hand"
                MouseDown="RecommendedCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cover art + badges + play button -->
                    <Grid Grid.Row="0" Background="#2C2C2E">
                        <Image
                            Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Score badge (top-right) -->
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#1E1B4B">
                            <TextBlock
                                Text="{Binding OccurrenceCount, StringFormat='{}×{0}'}"
                                FontSize="10"
                                Foreground="#A5B4FC"
                                FontWeight="SemiBold" />
                        </Border>

                        <!-- Downloaded badge (top-left) -->
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#14532D">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="✓ No PC" FontSize="10" Foreground="#86EFAC" FontWeight="SemiBold" />
                        </Border>

                        <!-- Downloading badge (top-left) -->
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#78350F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="10" Foreground="#FDE68A" />
                        </Border>

                        <!-- Queued badge (top-left) -->
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#1E3A5F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Na fila" FontSize="10" Foreground="#93C5FD" />
                        </Border>

                        <!-- Play button (when downloaded and file exists) -->
                        <Border
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="PlayForYouCard_MouseDown"
                            Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="0.88" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Text="▶"
                                FontSize="16"
                                Foreground="#111111"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="3,0,0,0" />
                        </Border>
                    </Grid>

                    <!-- Info -->
                    <StackPanel Grid.Row="1" Margin="12,10,12,14">
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F9FAFB"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Artist}"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis" />

                        <!-- Recognition count badge (only when track is in history) -->
                        <Border
                            Background="#1F2937"
                            CornerRadius="5"
                            Padding="7,3"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InHistory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}"
                                FontSize="10"
                                Foreground="#9CA3AF" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Large music card (190×190 cover) -->
        <DataTemplate x:Key="MusicCardTemplate">
            <Border
                Width="190"
                Margin="5"
                CornerRadius="14"
                ClipToBounds="True"
                Cursor="Hand"
                MouseDown="MusicCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cover art + status badges -->
                    <Grid Grid.Row="0" Background="#2C2C2E">
                        <Image
                            Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Downloaded badge -->
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#14532D">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="✓ No PC" FontSize="10" Foreground="#86EFAC" FontWeight="SemiBold" />
                        </Border>

                        <!-- Downloading badge -->
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#78350F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="10" Foreground="#FDE68A" />
                        </Border>

                        <!-- Queued badge -->
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="#1E3A5F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Na fila" FontSize="10" Foreground="#93C5FD" />
                        </Border>

                        <!-- Play button (downloaded tracks only) -->
                        <Border
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="PlayCard_MouseDown"
                            Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="0.88" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Text="▶"
                                FontSize="16"
                                Foreground="#111111"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="3,0,0,0" />
                        </Border>
                    </Grid>

                    <!-- Info -->
                    <StackPanel Grid.Row="1" Margin="12,10,12,14">
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F9FAFB"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Artist}"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Background="#1F2937"
                            CornerRadius="5"
                            Padding="7,3"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left">
                            <TextBlock
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}"
                                FontSize="10"
                                Foreground="#9CA3AF" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Download queue row (DownloadedTrack — live INotifyPropertyChanged) -->
        <DataTemplate x:Key="DownloadQueueRowTemplate">
            <Border CornerRadius="10" Margin="0,3" Background="#1C1C1E">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="52" Height="52" Background="#2C2C2E">
                        <Image Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Title + Artist + Progress bar -->
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Height="3"
                            Margin="0,7,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Progress}"
                            Background="#2C2C2E"
                            Foreground="#F59E0B"
                            BorderThickness="0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Status badge -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Downloading -->
                        <Border CornerRadius="6" Padding="10,5" Background="#78350F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#FDE68A" />
                        </Border>
                        <!-- Queued -->
                        <Border CornerRadius="6" Padding="10,5" Background="#1E3A5F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Na fila" FontSize="11" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact history row -->
        <DataTemplate x:Key="CompactRowTemplate">
            <Border
                CornerRadius="10"
                Margin="0,3"
                Cursor="Hand"
                MouseDown="MusicCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover + play overlay -->
                    <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="52" Height="52" Background="#2C2C2E">
                        <Grid>
                            <Image
                                Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseDown="PlayCard_MouseDown"
                                Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0.88" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Text="▶"
                                    FontSize="9"
                                    Foreground="#111111"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title + artist -->
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Artist}"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Meta badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Downloaded -->
                        <Border CornerRadius="5" Padding="8,4" Margin="0,0,6,0" Background="#14532D">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="✓ No PC" FontSize="10" Foreground="#86EFAC" FontWeight="SemiBold" />
                        </Border>

                        <!-- Downloading -->
                        <Border CornerRadius="5" Padding="8,4" Margin="0,0,6,0" Background="#78350F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="10" Foreground="#FDE68A" />
                        </Border>

                        <!-- Queued -->
                        <Border CornerRadius="5" Padding="8,4" Margin="0,0,6,0" Background="#1E3A5F">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Na fila" FontSize="10" Foreground="#93C5FD" />
                        </Border>

                        <!-- Count -->
                        <Border Background="#1F2937" CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}"
                                FontSize="11"
                                Foreground="#9CA3AF" />
                        </Border>

                        <!-- Date -->
                        <TextBlock
                            Text="{Binding LastRecognizedAt, StringFormat='dd/MM  HH:mm'}"
                            FontSize="11"
                            Foreground="#6B7280"
                            VerticalAlignment="Center"
                            Width="90" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Header bar ══ -->
        <Border
            Grid.Row="0"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,0,0,1"
            Padding="24,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Suas Músicas" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#6B7280" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Search bar -->
                    <Border Background="#1C1C1E" CornerRadius="10" Padding="12,0" Width="310" BorderBrush="#2C2C2E" BorderThickness="1">
                        <Grid>
                            <TextBlock
                                x:Name="SearchPlaceholder"
                                Text="🔍  Buscar músicas ou artistas..."
                                Foreground="#6B7280"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Margin="0,10"
                                IsHitTestVisible="False" />
                            <TextBox
                                x:Name="SearchBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                CaretBrush="White"
                                SelectionBrush="#6366F1"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Padding="0,10"
                                TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Scrollable content ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ── Normal sections (hidden while searching) ── -->
                <StackPanel x:Name="SectionsPanel">

                    <!-- ● Em Alta Agora -->
                    <StackPanel x:Name="TrendingSection" Margin="24,28,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" Background="#6366F1" CornerRadius="2" Margin="0,0,10,0" />
                                    <TextBlock Text="Em Alta Agora" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Text="O que você mais ouve ultimamente"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="14,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Padding="0,0,0,8">
                            <ItemsControl x:Name="TrendingList" ItemTemplate="{StaticResource MusicCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="TrendingEmpty"
                            Text="Nenhuma música ouvida nos últimos 30 dias."
                            FontSize="13"
                            Foreground="#6B7280"
                            Margin="4,8,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ● Para Você Agora -->
                    <StackPanel x:Name="ForYouSection" Margin="24,30,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" Background="#8B5CF6" CornerRadius="2" Margin="0,0,10,0" />
                                    <TextBlock Text="Para Você Agora" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Text="Baseado no que você está ouvindo hoje"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="14,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Padding="0,0,0,8">
                            <ItemsControl x:Name="ForYouList" ItemTemplate="{StaticResource RecommendedCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="ForYouEmpty"
                            Text="Continue ouvindo músicas para receber recomendações personalizadas."
                            FontSize="13"
                            Foreground="#6B7280"
                            Margin="4,8,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ● Tempo de Saudade -->
                    <StackPanel x:Name="SaudadeSection" Margin="24,30,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" Background="#EC4899" CornerRadius="2" Margin="0,0,10,0" />
                                    <TextBlock Text="Tempo de Saudade" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Text="Músicas que você curte mas faz tempo que não aparecem"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="14,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Padding="0,0,0,8">
                            <ItemsControl x:Name="SaudadeList" ItemTemplate="{StaticResource MusicCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="SaudadeEmpty"
                            Text="Nenhuma música encontrada nessa categoria ainda."
                            FontSize="13"
                            Foreground="#6B7280"
                            Margin="4,8,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#2C2C2E" Margin="24,30,24,0" />

                    <!-- ● Histórico Recente -->
                    <StackPanel Margin="24,26,24,28">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" Margin="0,0,10,0" />
                                    <TextBlock Text="Histórico Recente" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Text="Últimas músicas reconhecidas"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="14,5,0,0" />
                            </StackPanel>
                            <Button
                                x:Name="ToggleHistoryBtn"
                                Content="Ver tudo →"
                                Click="ToggleHistory_Click"
                                Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Recent 5 items -->
                        <ItemsControl x:Name="RecentHistoryList" ItemTemplate="{StaticResource CompactRowTemplate}" />

                        <TextBlock
                            x:Name="HistoryEmpty"
                            Text="Nenhuma música reconhecida ainda. Comece a ouvir música!"
                            FontSize="13"
                            Foreground="#6B7280"
                            Margin="4,12,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>

                <!-- ● Fila de Downloads -->
                <StackPanel x:Name="DownloadQueueSection" Margin="24,0,24,28">

                    <!-- Divider -->
                    <Border Height="1" Background="#2C2C2E" Margin="0,0,0,26" />

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="22" Background="#F59E0B" CornerRadius="2" Margin="0,0,10,0" />
                                <TextBlock Text="Fila de Downloads" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border x:Name="DownloadQueueCountBadge" Background="#1C1C1E" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadQueueCountText" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="Músicas com 10+ reconhecimentos aguardando download via yt-dlp"
                                FontSize="12"
                                Foreground="#6B7280"
                                Margin="14,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="DownloadQueueList" ItemTemplate="{StaticResource DownloadQueueRowTemplate}" />

                    <TextBlock
                        x:Name="DownloadQueueEmpty"
                        Text="Nenhum download na fila no momento."
                        FontSize="13"
                        Foreground="#6B7280"
                        Margin="4,8,0,0"
                        Visibility="Collapsed" />
                </StackPanel>

                </StackPanel>

                <!-- ── Search results panel ── -->
                <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Margin="24,24,24,28">
                    <TextBlock
                        x:Name="SearchResultsHeader"
                        FontSize="14"
                        Foreground="#9CA3AF"
                        Margin="0,0,0,14" />

                    <ItemsControl x:Name="SearchResultsList" ItemTemplate="{StaticResource CompactRowTemplate}" />

                    <!-- Search pagination -->
                    <StackPanel x:Name="SearchPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,4">
                        <Button x:Name="SearchPrevBtn" Content="← Anterior" Click="SearchPrev_Click" Style="{StaticResource PageBtn}" />
                        <TextBlock
                            x:Name="SearchPageInfo"
                            VerticalAlignment="Center"
                            Margin="18,0"
                            FontSize="13"
                            Foreground="#9CA3AF" />
                        <Button x:Name="SearchNextBtn" Content="Próxima →" Click="SearchNext_Click" Style="{StaticResource PageBtn}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="SearchEmpty"
                        Text="Nenhuma música encontrada para essa busca."
                        FontSize="14"
                        Foreground="#6B7280"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0"
                        Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

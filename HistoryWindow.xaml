<Window
    x:Class="Music.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Music"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Your Music — Music Recognizer"
    Width="1060"
    Height="760"
    MinWidth="800"
    MinHeight="560"
    Background="#111111"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
        </Style>

        <!--  Ghost/action button  -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Filled primary button  -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7578F3" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Page nav button  -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Recommendation card (ForYouItem) — enriched when track exists in history  -->
        <DataTemplate x:Key="RecommendedCardTemplate">
            <Border
                Width="190"
                Margin="5"
                ClipToBounds="True"
                CornerRadius="14"
                Cursor="Hand"
                MouseDown="RecommendedCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Cover art + badges + play button  -->
                    <Grid Grid.Row="0" Background="#2C2C2E">
                        <Image
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                            Stretch="UniformToFill" />

                        <!--  Score badge (top-right)  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#1E1B4B"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#A5B4FC"
                                Text="{Binding OccurrenceCount, StringFormat='{}×{0}'}" />
                        </Border>

                        <!--  Downloaded badge (top-left)  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#14532D"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#86EFAC"
                                Text="Downloaded" />
                        </Border>

                        <!--  Downloading badge (top-left)  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#78350F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#FDE68A"
                                Text="{Binding DownloadStatusText}" />
                        </Border>

                        <!--  Queued badge (top-left)  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#1E3A5F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#93C5FD"
                                Text="In Queue" />
                        </Border>

                        <!--  Play button (when downloaded and file exists)  -->
                        <Border
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="22"
                            Cursor="Hand"
                            MouseDown="PlayForYouCard_MouseDown"
                            Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="0.88" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Margin="3,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#111111"
                                Text="▶" />
                        </Border>
                    </Grid>

                    <!--  Info  -->
                    <StackPanel Grid.Row="1" Margin="12,10,12,14">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F9FAFB"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />

                        <!--  Recognition count badge (only when track is in history)  -->
                        <Border
                            Margin="0,8,0,0"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            Background="#1F2937"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InHistory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#9CA3AF"
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Large music card (190×190 cover)  -->
        <DataTemplate x:Key="MusicCardTemplate">
            <Border
                Width="190"
                Margin="5"
                ClipToBounds="True"
                CornerRadius="14"
                Cursor="Hand"
                MouseDown="MusicCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Cover art + status badges  -->
                    <Grid Grid.Row="0" Background="#2C2C2E">
                        <Image
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                            Stretch="UniformToFill" />

                        <!--  Downloaded badge  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#14532D"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#86EFAC"
                                Text="Downloaded" />
                        </Border>

                        <!--  Downloading badge  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#78350F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#FDE68A"
                                Text="{Binding DownloadStatusText}" />
                        </Border>

                        <!--  Queued badge  -->
                        <Border
                            Margin="8"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#1E3A5F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#93C5FD"
                                Text="In Queue" />
                        </Border>

                        <!--  Play button (downloaded tracks only)  -->
                        <Border
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="22"
                            Cursor="Hand"
                            MouseDown="PlayCard_MouseDown"
                            Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="0.88" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Margin="3,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#111111"
                                Text="▶" />
                        </Border>
                    </Grid>

                    <!--  Info  -->
                    <StackPanel Grid.Row="1" Margin="12,10,12,14">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F9FAFB"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Margin="0,8,0,0"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            Background="#1F2937"
                            CornerRadius="5">
                            <TextBlock
                                FontSize="10"
                                Foreground="#9CA3AF"
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Download queue row (DownloadedTrack — live INotifyPropertyChanged)  -->
        <DataTemplate x:Key="DownloadQueueRowTemplate">
            <Border
                Margin="0,3"
                Background="#1C1C1E"
                CornerRadius="10">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover  -->
                    <Border
                        Grid.Column="0"
                        Width="52"
                        Height="52"
                        Background="#2C2C2E"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Image
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                            Stretch="UniformToFill" />
                    </Border>

                    <!--  Title + Artist + Progress bar  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,14,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Height="3"
                            Margin="0,7,0,0"
                            Background="#2C2C2E"
                            BorderThickness="0"
                            Foreground="#F59E0B"
                            Maximum="100"
                            Minimum="0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                            Value="{Binding Progress}" />
                    </StackPanel>

                    <!--  Status badge  -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!--  Downloading  -->
                        <Border
                            Padding="10,5"
                            Background="#78350F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="11"
                                Foreground="#FDE68A"
                                Text="{Binding StatusText}" />
                        </Border>
                        <!--  Queued  -->
                        <Border
                            Padding="10,5"
                            Background="#1E3A5F"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="11"
                                Foreground="#93C5FD"
                                Text="In Queue" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Compact history row  -->
        <DataTemplate x:Key="CompactRowTemplate">
            <Border
                Margin="0,3"
                CornerRadius="10"
                Cursor="Hand"
                MouseDown="MusicCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover + play overlay  -->
                    <Border
                        Grid.Column="0"
                        Width="52"
                        Height="52"
                        Background="#2C2C2E"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                                Stretch="UniformToFill" />
                            <Border
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="13"
                                Cursor="Hand"
                                MouseDown="PlayCard_MouseDown"
                                Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0.88" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="#111111"
                                    Text="▶" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Title + artist  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,10,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  Meta badges  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Downloaded  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#14532D"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#86EFAC"
                                Text="Downloaded" />
                        </Border>

                        <!--  Downloading  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#78350F"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#FDE68A"
                                Text="{Binding DownloadStatusText}" />
                        </Border>

                        <!--  Queued  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#1E3A5F"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#93C5FD"
                                Text="In Queue" />
                        </Border>

                        <!--  Count  -->
                        <Border
                            Margin="0,0,10,0"
                            Padding="8,4"
                            Background="#1F2937"
                            CornerRadius="5">
                            <TextBlock
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}" />
                        </Border>

                        <!--  Date  -->
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#6B7280"
                            Text="{Binding LastRecognizedAt, StringFormat='dd/MM  HH:mm'}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══ Header bar ══  -->
        <Border
            Grid.Row="0"
            Padding="24,16"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Your Music" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#6B7280" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Search bar  -->
                    <Border
                        Width="310"
                        Padding="12,0"
                        Background="#1C1C1E"
                        BorderBrush="#2C2C2E"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <TextBlock
                                x:Name="SearchPlaceholder"
                                Margin="0,10"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#6B7280"
                                IsHitTestVisible="False"
                                Text="🔍  Search songs or artists..." />
                            <TextBox
                                x:Name="SearchBox"
                                Padding="0,10"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="White"
                                FontSize="13"
                                Foreground="White"
                                SelectionBrush="#6366F1"
                                TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!--  ══ Scrollable content ══  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ── Normal sections (hidden while searching) ──  -->
                <StackPanel x:Name="SectionsPanel">

                    <!--  ● Em Alta Agora  -->
                    <StackPanel x:Name="TrendingSection" Margin="24,28,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Background="#6366F1"
                                        CornerRadius="2" />
                                    <TextBlock
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Text="Trending Now" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            Padding="0,0,0,8"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TrendingList" ItemTemplate="{StaticResource MusicCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="TrendingEmpty"
                            Margin="4,8,0,0"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="No music listened in the last 30 days."
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  ● For You Now  -->
                    <StackPanel x:Name="ForYouSection" Margin="24,30,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Background="#8B5CF6"
                                        CornerRadius="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Text="For You Now" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            Padding="0,0,0,8"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ForYouList" ItemTemplate="{StaticResource RecommendedCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="ForYouEmpty"
                            Margin="4,8,0,0"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="Keep listening to songs to get personalized recommendations."
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  ● Throwback Time  -->
                    <StackPanel x:Name="SaudadeSection" Margin="24,30,24,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Background="#EC4899"
                                        CornerRadius="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Text="Throwback Time" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            Padding="0,0,0,8"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SaudadeList" ItemTemplate="{StaticResource MusicCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="SaudadeEmpty"
                            Margin="4,8,0,0"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="No songs found in this category yet."
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="24,30,24,0"
                        Background="#2C2C2E" />

                    <!--  ● Recent History  -->
                    <StackPanel Margin="24,26,24,28">
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Background="#10B981"
                                        CornerRadius="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Text="Recent" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                x:Name="ToggleHistoryBtn"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ToggleHistory_Click"
                                Content="View All →"
                                Style="{StaticResource GhostBtn}" />
                        </Grid>

                        <!--  Recent 5 items  -->
                        <ItemsControl x:Name="RecentHistoryList" ItemTemplate="{StaticResource CompactRowTemplate}" />

                        <TextBlock
                            x:Name="HistoryEmpty"
                            Margin="4,12,0,0"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="No music recognized yet. Start listening to music!"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  ● Download Queue  -->
                    <StackPanel x:Name="DownloadQueueSection" Margin="24,0,24,28">

                        <!--  Divider  -->
                        <Border
                            Height="1"
                            Margin="0,0,0,26"
                            Background="#2C2C2E" />

                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Background="#F59E0B"
                                        CornerRadius="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Text="Download Queue" />
                                    <Border
                                        x:Name="DownloadQueueCountBadge"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Background="#1C1C1E"
                                        CornerRadius="6">
                                        <TextBlock
                                            x:Name="DownloadQueueCountText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#F59E0B" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Margin="14,5,0,0"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Text="Pending songs with 10+ recognitions" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="DownloadQueueList" ItemTemplate="{StaticResource DownloadQueueRowTemplate}" />

                        <TextBlock
                            x:Name="DownloadQueueEmpty"
                            Margin="4,8,0,0"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="No downloads in queue at the moment."
                            Visibility="Collapsed" />
                    </StackPanel>

                </StackPanel>

                <!--  ── Search results panel ──  -->
                <StackPanel
                    x:Name="SearchPanel"
                    Margin="24,24,24,28"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="SearchResultsHeader"
                        Margin="0,0,0,14"
                        FontSize="14"
                        Foreground="#9CA3AF" />

                    <ItemsControl x:Name="SearchResultsList" ItemTemplate="{StaticResource CompactRowTemplate}" />

                    <!--  Search pagination  -->
                    <StackPanel
                        x:Name="SearchPaginationPanel"
                        Margin="0,18,0,4"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="SearchPrevBtn"
                            Click="SearchPrev_Click"
                            Content="← Anterior"
                            Style="{StaticResource PageBtn}" />
                        <TextBlock
                            x:Name="SearchPageInfo"
                            Margin="18,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#9CA3AF" />
                        <Button
                            x:Name="SearchNextBtn"
                            Click="SearchNext_Click"
                            Content="Next →"
                            Style="{StaticResource PageBtn}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="SearchEmpty"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="#6B7280"
                        Text="No songs found for this search."
                        Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

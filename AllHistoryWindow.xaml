<Window
    x:Class="Music.AllHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Music"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Complete History — Music Recognizer"
    Width="1060"
    Height="760"
    MinWidth="800"
    MinHeight="560"
    Background="#111111"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
        </Style>

        <!--  Ghost button  -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Sort button (inactive)  -->
        <Style x:Key="SortBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Sort button (active/selected)  -->
        <Style x:Key="SortBtnActive" TargetType="Button">
            <Setter Property="Background" Value="#312E81" />
            <Setter Property="Foreground" Value="#A5B4FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#6366F1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3730A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Page nav button  -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Compact history row  -->
        <DataTemplate x:Key="CompactRowTemplate">
            <Border
                Margin="0,3"
                CornerRadius="10"
                Cursor="Hand"
                MouseDown="MusicCard_MouseDown"
                Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1C1C1E" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover + play overlay  -->
                    <Border
                        Grid.Column="0"
                        Width="52"
                        Height="52"
                        Background="#2C2C2E"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding CoverArtUrl, Converter={x:Static local:CoverArtConverter.Instance}}"
                                Stretch="UniformToFill" />
                            <Border
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="13"
                                Cursor="Hand"
                                MouseDown="PlayCard_MouseDown"
                                Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0.88" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="#111111"
                                    Text="▶" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Title + artist  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,10,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  Meta badges  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Downloaded  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#14532D"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#86EFAC"
                                Text="Downloaded" />
                        </Border>

                        <!--  Downloading  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#78350F"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#FDE68A"
                                Text="{Binding DownloadStatusText}" />
                        </Border>

                        <!--  Queued  -->
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Background="#1E3A5F"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10"
                                Foreground="#93C5FD"
                                Text="Queued" />
                        </Border>

                        <!--  Count  -->
                        <Border
                            Margin="0,0,10,0"
                            Padding="8,4"
                            Background="#1F2937"
                            CornerRadius="5">
                            <TextBlock
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="{Binding RecognitionCount, StringFormat='{}{0}×'}" />
                        </Border>

                        <!--  Date  -->
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#6B7280"
                            Text="{Binding LastRecognizedAt, StringFormat='dd/MM  HH:mm'}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ══ Header ══  -->
        <Border
            Grid.Row="0"
            Padding="24,16"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Complete History" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#6B7280" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ══ Sort bar ══  -->
        <Border
            Grid.Row="1"
            Padding="24,12"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="Sort by:" />

                <!--  Date buttons  -->
                <Button
                    x:Name="SortDateDescBtn"
                    Margin="0,0,6,0"
                    Click="SortDateDesc_Click"
                    Content="Date ↓"
                    Style="{StaticResource SortBtnActive}" />
                <Button
                    x:Name="SortDateAscBtn"
                    Margin="0,0,18,0"
                    Click="SortDateAsc_Click"
                    Content="Date ↑"
                    Style="{StaticResource SortBtn}" />

                <!--  Recognition count buttons  -->
                <Button
                    x:Name="SortCountDescBtn"
                    Margin="0,0,6,0"
                    Click="SortCountDesc_Click"
                    Content="Recognitions ↓"
                    Style="{StaticResource SortBtn}" />
                <Button
                    x:Name="SortCountAscBtn"
                    Margin="0,0,18,0"
                    Click="SortCountAsc_Click"
                    Content="Recognitions ↑"
                    Style="{StaticResource SortBtn}" />

                <!--  Alphabetical buttons  -->
                <Button
                    x:Name="SortNameAscBtn"
                    Margin="0,0,6,0"
                    Click="SortNameAsc_Click"
                    Content="A → Z"
                    Style="{StaticResource SortBtn}" />
                <Button
                    x:Name="SortNameDescBtn"
                    Click="SortNameDesc_Click"
                    Content="Z → A"
                    Style="{StaticResource SortBtn}" />
            </StackPanel>
        </Border>

        <!--  ══ List ══  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,8">
                <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource CompactRowTemplate}" />

                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#6B7280"
                    Text="No music recognized yet."
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!--  ══ Pagination ══  -->
        <Border
            Grid.Row="3"
            Padding="24,12"
            Background="#161618"
            BorderBrush="#2C2C2E"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PrevPageBtn"
                        Click="PrevPage_Click"
                        Content="← Previous"
                        Style="{StaticResource PageBtn}" />
                    <TextBlock
                        x:Name="PageInfoText"
                        Margin="18,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#9CA3AF" />
                    <Button
                        x:Name="NextPageBtn"
                        Click="NextPage_Click"
                        Content="Next →"
                        Style="{StaticResource PageBtn}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

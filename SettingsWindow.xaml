<Window
    x:Class="Music.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings - Music Recognizer"
    Width="500"
    MaxHeight="800"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="20"
            FontWeight="Bold"
            Text="Settings" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Recognition  -->
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Recognition" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <TextBlock Margin="0,5,0,5" Text="Minimum delay between recognitions (ms):" />
                <TextBox x:Name="DelayMinTextBox" Text="2200" />

                <TextBlock Margin="0,10,0,5" Text="Maximum delay between recognitions (ms):" />
                <TextBox x:Name="DelayMaxTextBox" Text="5500" />

                <!--  Visualizer  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Visualizer" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <TextBlock Margin="0,5,0,5" Text="Number of bars:" />
                <TextBox x:Name="VisualizerBarsTextBox" Text="32" />

                <TextBlock Margin="0,10,0,5" Text="Visualizer FPS:" />
                <TextBox x:Name="VisualizerFpsTextBox" Text="60" />

                <!--  History  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="History" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <CheckBox
                    x:Name="SaveHistoryCheckBox"
                    Content="Save recognized music history"
                    IsChecked="True" />

                <TextBlock Margin="0,10,0,5" Text="Maximum history items:" />
                <TextBox x:Name="MaxHistoryTextBox" Text="1000" />

                <!--  Downloads  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Downloads" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <TextBlock Margin="0,10,0,5" Text="Download directory:" />
                <TextBox x:Name="DownloadDirTextBox" />

                <TextBlock Margin="0,5,0,8" Text="Simultaneous downloads (yt-dlp instances):" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        x:Name="ConcurrentDownloadsSlider"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        LargeChange="1"
                        Maximum="10"
                        Minimum="1"
                        SmallChange="1"
                        TickFrequency="1"
                        ValueChanged="ConcurrentDownloadsSlider_ValueChanged"
                        Value="2" />
                    <TextBlock
                        x:Name="ConcurrentDownloadsLabel"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="2" />
                </Grid>
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="11"
                    Foreground="#999999"
                    Text="Each instance opens a separate yt-dlp process. High values may saturate your network." />

                <!--  Integrations  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Integrations" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <CheckBox
                    x:Name="DiscordRpcCheckBox"
                    Content="Enable Discord Rich Presence"
                    IsChecked="True" />

                <!--  Data  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Data" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Button
                    x:Name="ClearHistoryButton"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    Background="#D13438"
                    Click="ClearHistoryButton_Click"
                    Content="Clear History" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Margin="0,0,10,0"
                Background="#3F3F46"
                Click="CancelButton_Click"
                Content="Cancel" />
            <Button
                x:Name="SaveButton"
                Click="SaveButton_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</Window>





<Window
    x:Class="Music.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings - Music Recognizer"
    Width="500"
    MaxHeight="800"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Recognition  -->
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Recognition" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Grid Margin="0,0,0,5">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Minimum delay between recognitions (ms):" />
                    <TextBox
                        x:Name="DelayMinTextBox"
                        Width="100"
                        HorizontalAlignment="Right"
                        Text="2200"
                        TextAlignment="Right" />
                </Grid>


                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Maximum delay between recognitions (ms):" />
                    <TextBox
                        x:Name="DelayMaxTextBox"
                        Width="100"
                        HorizontalAlignment="Right"
                        Text="5500"
                        TextAlignment="Right" />
                </Grid>


                <!--  Visualizer  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Visualizer" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Number of bars:" />
                    <TextBox
                        x:Name="VisualizerBarsTextBox"
                        Width="100"
                        HorizontalAlignment="Right"
                        Text="32"
                        TextAlignment="Right" />
                </Grid>


                <!--  History  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="History" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Enable History" />

                    <CheckBox
                        x:Name="SaveHistoryCheckBox"
                        HorizontalAlignment="Right"
                        IsChecked="True" />
                </Grid>



                <!--  Downloads  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Downloads" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Grid Margin="0,0,0,5">
                    <TextBlock VerticalAlignment="Center" Text="Directory:" />
                    <TextBox
                        x:Name="DownloadDirTextBox"
                        Width="380"
                        HorizontalAlignment="Right"
                        TextAlignment="Right" />
                </Grid>

                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Simultaneous downloads (yt-dlp instances):" />
                    <TextBox
                        x:Name="ConcurrentDownloadsSlider"
                        Width="100"
                        HorizontalAlignment="Right"
                        Text="5"
                        TextAlignment="Right" />
                </Grid>

                <!--  Integrations  -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Integrations" />
                <Separator Margin="0,5,0,10" Background="#3F3F46" />

                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFC8C8C8"
                        Text="Discord Rich Presence" />

                    <CheckBox
                        x:Name="DiscordRpcCheckBox"
                        HorizontalAlignment="Right"
                        IsChecked="True" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="ClearHistoryButton"
                Background="#D13438"
                Click="ClearHistoryButton_Click"
                Content="Clear History" />
            <Button
                x:Name="CancelButton"
                Margin="10,0,10,0"
                Background="#3F3F46"
                Click="CancelButton_Click"
                Content="Cancel" />
            <Button
                x:Name="SaveButton"
                Click="SaveButton_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</Window>




